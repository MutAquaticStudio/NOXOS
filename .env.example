# Only the explicitly approved VITE_NOX_* and VITE_TURNSTILE_* namespaces may be
# bundled. Provider VITE_VERCEL_* metadata is ignored by the client build; every
# other VITE_* key is rejected. Never put secrets here.
VITE_NOX_ENV=preview
VITE_NOX_SOURCE_SHA=local
VITE_TURNSTILE_SITE_KEY=

# Server-only variables. Configure these in the cloud provider's encrypted environment.
NOX_RUNTIME_DATABASE_URL=
NOX_WORKFLOW_DATABASE_URL=
NOX_MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_STORAGE_BUCKET=nox-os-staging-private
# CI-only protected fingerprints; never put a Production credential in a non-production environment.
NOX_CURRENT_RUNTIME_DATABASE_URL_SHA256=
NOX_PRODUCTION_RUNTIME_DATABASE_URL_SHA256=
NOX_CURRENT_WORKFLOW_DATABASE_URL_SHA256=
NOX_PRODUCTION_WORKFLOW_DATABASE_URL_SHA256=
NOX_CURRENT_SUPABASE_SERVICE_ROLE_KEY_SHA256=
NOX_PRODUCTION_SUPABASE_SERVICE_ROLE_KEY_SHA256=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_COMMIT_REF=
VERCEL_TARGET_ENV=
NOX_STAGING_BRANCH=
NOX_DIAGNOSTIC_PROBE_TOKEN=
NOX_FOUNDATION_DIAGNOSTICS_ENABLED=false
VERCEL_AUTOMATION_BYPASS_SECRET=
CF_API_TOKEN=
CF_ZONE_ID=
CF_ACCOUNT_ID=
NOX_PUBLIC_APP_HOSTNAME=
VERCEL_PUBLIC_CNAME_TARGET=
NOX_OPS_HOSTNAME=
CF_PRIVILEGED_CNAME_TARGET=
CF_ACCESS_IDENTITY_GROUP_ID=
CF_CREATE_TURNSTILE_WIDGET=false
CF_PRIVILEGED_PROXY_APPROVED=false
