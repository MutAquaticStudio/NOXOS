# Only the explicitly approved VITE_NOX_* namespace may be bundled. Provider
# VITE_VERCEL_* metadata is ignored by the client build; every other VITE_* key
# is rejected. Never put secrets here.
VITE_NOX_ENV=preview
VITE_NOX_SOURCE_SHA=local
# Public browser configuration only; neither value is a server credential.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only variables. Configure these in the cloud provider's encrypted environment.
NOX_RUNTIME_DATABASE_URL=
NOX_WORKFLOW_DATABASE_URL=
NOX_MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_STORAGE_BUCKET=nox-os-staging-private
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_COMMIT_REF=
VERCEL_TARGET_ENV=
NOX_STAGING_BRANCH=
NOX_DIAGNOSTIC_PROBE_TOKEN=
NOX_FOUNDATION_DIAGNOSTICS_ENABLED=false
NOX_PLATFORM_OWNER_BOOTSTRAP_USER_ID=
VERCEL_AUTOMATION_BYPASS_SECRET=
