# Public variables may be bundled only when prefixed VITE_. Never put secrets here.
VITE_NOX_ENV=preview
VITE_NOX_SOURCE_SHA=local
VITE_TURNSTILE_SITE_KEY=

# Server-only variables. Configure these in the cloud provider's encrypted environment.
NOX_RUNTIME_DATABASE_URL=
NOX_MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nox-private
# CI-only protected fingerprints; never put a Production credential in a non-production environment.
NOX_CURRENT_RUNTIME_DATABASE_URL_SHA256=
NOX_PRODUCTION_RUNTIME_DATABASE_URL_SHA256=
NOX_CURRENT_SUPABASE_SERVICE_ROLE_KEY_SHA256=
NOX_PRODUCTION_SUPABASE_SERVICE_ROLE_KEY_SHA256=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_COMMIT_REF=
VERCEL_TARGET_ENV=
NOX_STAGING_BRANCH=
NOX_WORKFLOW_PROBE_URL=
NOX_WORKFLOW_PROBE_TOKEN=
NOX_DIAGNOSTIC_PROBE_TOKEN=
