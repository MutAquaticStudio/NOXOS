{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @nox-os/web build",
  "outputDirectory": "apps/nox-os/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/[...route]"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
